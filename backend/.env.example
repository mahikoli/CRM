# Database URL:
# For local SQLite: sqlite:///./hruta_onecrm.db
# For Render PostgreSQL, Supabase, Neon:
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE (or standard postgres:// URL)
DATABASE_URL=postgresql://postgres.uiuonbxcxutsdadcvjpf:pramKOLI1137@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# Random string for signing JWT tokens (generate using: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=replace-with-a-long-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed frontend origins (comma-separated). Set to your Vercel domain in production:
# e.g. https://your-crm-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Regex pattern allowing all Vercel preview/production domains:
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Local/persistent storage directory for uploads
UPLOAD_DIR=private_uploads
